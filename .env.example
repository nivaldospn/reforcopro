# Reforço Pro - Variáveis de Ambiente
# Copie este arquivo como .env.local e preencha com seus valores

# ─── Supabase (obrigatório) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Supabase Service Role Key (APENAS no servidor/Vercel — NUNCA exponha no frontend)
# Obtenha em: Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ─── Datafy API (WhatsApp Business) ──────────────────────────────────────────
# Token de acesso da sua conta Datafy (APENAS no servidor/Vercel)
DATAFY_API_TOKEN=seu-token-datafy-aqui

# URL base da Datafy API (não altere, a menos que a Datafy indique outro endpoint)
DATAFY_API_BASE_URL=https://cloud.datafyapi.com.br/v1

# ─── Cron Job (automação diária) ─────────────────────────────────────────────
# Senha secreta para proteger o endpoint /api/cron/payment-reminders
# Gere uma string aleatória longa: ex: openssl rand -hex 32
# Configure esta mesma chave nas Environment Variables da Vercel
CRON_SECRET=sua-senha-secreta-aleatoria-aqui
